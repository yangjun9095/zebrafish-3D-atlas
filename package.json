{
  "name": "zebrafish-3d-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Interactive 3D model of zebrafish development, from the 1-cell zygote to the adult fish",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangjun9095/zebrafish-3D-atlas.git"
  },
  "homepage": "https://github.com/yangjun9095/zebrafish-3D-atlas#readme",
  "bugs": {
    "url": "https://github.com/yangjun9095/zebrafish-3D-atlas/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "dev:lan": "vite --host --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gate": "npm run check && npm run lint && npm test && npm run validate && npm run gen:body -- --check && npm run gen:vocab -- --check && npm run sources -- --check && npm run attribution -- --check && npm run notices -- --check && npm run build && npm run csp && npm run test:e2e",
    "bundle": "VITE_SINGLE_FILE=1 npm run build && node scripts/bundle.ts",
    "validate": "node scripts/validate-data.ts",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "movie": "node scripts/render-movie.ts",
    "attribution": "node scripts/build-attribution.ts",
    "notices": "node scripts/build-notices.ts",
    "sources": "node scripts/build-sources.ts",
    "gen:body": "node scripts/gen-body.ts",
    "gen:vocab": "node scripts/build-vocabulary.ts",
    "csp": "node scripts/check-csp.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
