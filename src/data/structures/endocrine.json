  {
    "id": "ZFA:0001200",
    "name": "corpuscles of Stannius",
    "synonyms": [],
    "system": "endocrine",
    "alsoIn": [],
    "zfaParent": null,
    "uiParent": "ZFA:0001158",
    "parentRelation": "grouping",
    "definition": "Islands of eosinic cells found on the lateroventral surface of the kidney. Function is thought to be that of the parathyroid gland in other vertebrates, which are lacking in fishes. These cells secrete hypocalcin (teleocalcin) to regulate calcium metabolism.",
    "zfinStartStage": "ZFS:0000027",
    "zfinEndStage": "ZFS:0000044",
    "startHpf": 19.0,
    "endHpf": 17520.0,
    "visibleFromHpf": 50,
    "modelEndHpf": 4320,
    "overrideNote": "ZFA starts the corpuscles of Stannius at 20-25 somites (19 hpf) with the stc1-positive cells inside the tubule; the discrete glands sit on top of the ducts from about 50 hpf, when the atlas draws them (Naylor et al. 2018; research 03d; spec 3.5.7 moves the 24 hpf size row to 50). ZFA gives no part-of parent; shown under the endocrine system. DM-36: axis clamp at 4320 hpf.",
    "fadeInHpf": 0.6,
    "fadeOutHpf": 0,
    "laterality": "paired",
    "pickable": true,
    "sexSpecific": null,
    "aliasChain": [],
    "events": [
      {
        "hpf": 19,
        "text": "Term starts in ZFIN (20-25 somites); cells arise in the distal pronephros.",
        "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6250424/; https://pmc.ncbi.nlm.nih.gov/articles/PMC2042002/"
      },
      {
        "hpf": 24,
        "text": "Cdh17 down-regulated and stc1 expressed in the posterior distal early segment.",
        "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6250424/; https://pmc.ncbi.nlm.nih.gov/articles/PMC2042002/"
      },
      {
        "hpf": 32,
        "text": "Prominent bulge on the dorsal side of the tubule.",
        "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6250424/; https://pmc.ncbi.nlm.nih.gov/articles/PMC2042002/"
      },
      {
        "hpf": 42,
        "text": "Neighbouring epithelial cells meet under the extruding cells.",
        "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6250424/; https://pmc.ncbi.nlm.nih.gov/articles/PMC2042002/"
      },
      {
        "hpf": 50,
        "text": "Discrete separate glands on top of each tubule in about 70 percent of animals.",
        "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6250424/; https://pmc.ncbi.nlm.nih.gov/articles/PMC2042002/"
      },
      {
        "hpf": 60,
        "text": "Extrusion complete in most embryos.",
